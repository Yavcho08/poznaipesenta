{
  "name": "poznai-pesenta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/db.mjs push",
    "db:check": "node scripts/db.mjs check",
    "db:check-rls": "tsx scripts/check-rls.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:migrate-data": "tsx --conditions=react-server scripts/migrate-to-supabase.ts",
    "catalog:backfill": "tsx --conditions=react-server scripts/backfill-catalog.ts",
    "postinstall": "prisma generate",
    "import:artist": "tsx --conditions=react-server scripts/import-artist.ts",
    "vercel-build": "prisma generate && next build",
    "youtube:sync": "tsx --conditions=react-server scripts/youtube-sync.ts",
    "catalog:years": "tsx --conditions=react-server scripts/recompute-years.ts",
    "catalog:names": "tsx --conditions=react-server scripts/recompute-names.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "canvas-confetti": "^1.9.3",
    "mpg123-decoder": "^1.0.3",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "supabase": "^3.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
