# Копирай като .env.local и попълни. .env* файловете са в .gitignore — тайните никога не влизат в git.
# Във Vercel същите имена се задават в Project → Settings → Environment Variables.

# --- База (Supabase → Project Settings → Database → Connection string) ---
# Приложението: пулирана връзка, transaction mode (порт 6543).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# Миграции (npm run db:push), npm run db:check и скриптовете: session mode (порт 5432).
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase (Project Settings → API Keys) ---
# Публични — отиват и в браузъра (входът и Realtime). RLS пази таблиците.
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# ТАЙНА — само на сървъра (изтриване на акаунт и др. административни операции). Никога с NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# Само за CLI/скриптове на твоя компютър (Supabase → Account → Access Tokens). Не е нужна във Vercel.
SUPABASE_ACCESS_TOKEN=""

# --- Админ ---
# Имейли (разделени със запетая), които получават роля admin при влизане (достъп до /admin).
ADMIN_EMAILS="ti@example.com"

# --- Spotify (по желание; само списъци с песни, никога звук) ---
# Бутон „Вход със Spotify“ (true/false). Изисква Spotify provider в Supabase (Client ID + Secret).
# Spotify Development Mode допуска само ръчно добавени потребители — затова по подразбиране е изключен.
NEXT_PUBLIC_ENABLE_SPOTIFY_LOGIN="false"
# Spotify изисква 127.0.0.1 вместо localhost; локално отваряй сайта на http://127.0.0.1:3000
SPOTIFY_CLIENT_ID=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/spotify/callback"

# --- Нощна синхронизация (Vercel Cron → /api/cron/sync-catalog) ---
# Произволен дълъг низ (напр. `openssl rand -hex 24`). Vercel го праща сам като Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# YouTube Data API v3 (console.cloud.google.com → YouTube Data API v3 → API key) — гледания за „Коя е по-популярна?“.
YOUTUBE_API_KEY=""
# По желание: колко търсения на клип на ден (по 101 единици от квотата 10 000). По подразбиране 90.
YOUTUBE_DAILY_SEARCHES=""
