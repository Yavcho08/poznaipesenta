# База данни.
# Разработка: SQLite файл.
DATABASE_URL="file:./prisma/dev.db"
# Продукция (Neon Postgres): пулираната връзка за приложението…
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# …и директната (без -pooler) за миграциите.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Парола за /admin
ADMIN_PASSWORD="smeni-me"

# Spotify OAuth PKCE (по желание) — без client secret.
# Spotify изисква 127.0.0.1 вместо localhost; отваряй сайта на http://127.0.0.1:3000
SPOTIFY_CLIENT_ID=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/spotify/callback"
