# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env файлове (тайни) — само примерът се комитва
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma: генериран клиент и локалната SQLite база
/src/generated/
/prisma/*.db
/prisma/*.db-journal

# Лични настройки на Claude Code и „skills“, инсталирани от `prisma init` за AI агенти
# (не са част от приложението; skills-lock.json позволява да се инсталират пак).
/.claude/settings.local.json
/.claude/skills/
/.agents/
/.windsurf/
/skills-lock.json
