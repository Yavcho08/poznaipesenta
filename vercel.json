{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/sync-catalog",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-catalog?continue=1",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/sync-catalog?continue=2",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/youtube",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/youtube?part=15",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/youtube?part=30",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/youtube?part=45",
      "schedule": "45 4 * * *"
    }
  ]
}
